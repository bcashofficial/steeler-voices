# Committed dev values — every variable the service reads, nothing secret.
# Compose overrides DB_HOST with the postgres service name.
DJANGO_SECRET_KEY=dev-insecure-steeler-voices
DJANGO_DEBUG=true
DB_HOST=localhost
DB_PORT=5445
DB_NAME=steeler_voices
DB_USER=steeler_voices
DB_PASSWORD=steeler_voices
INTERNAL_API_KEY=dev-internal-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TAGGING_MODEL=qwen3:4b-instruct
OLLAMA_GENERATION_MODEL=qwen3:8b
